          //            SPACE=(TRK,(2,2),RLSE),
          //            RECFM=FBA,LRECL=133,BLKSIZE=0
       43 //SYSOUT   DD SYSOUT=*
       44 //CEEDUMP  DD SYSOUT=*
       45 //
       46 //STEP020  EXEC PGM=SORT
       47 //SYSOUT   DD SYSOUT=*
       48 //SORTIN   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
       49 //SORTOUT  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       50 //SYSIN    DD *
          /*
       51 //STEP030  EXEC PGM=FATFILTR
       52 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       53 //TRANSIN  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),DISP=SHR
       54 //APROVOUT DD DSN=&SYSUID..FATURA.TRANS.APROV,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,2),RLSE),
          //            RECFM=FB,LRECL=80,BLKSIZE=0
       55 //REJEIOUT DD DSN=&SYSUID..FATURA.TRANS.REJEI,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(1,1),RLSE),
          //            RECFM=FB,LRECL=120,BLKSIZE=0
       56 //SYSOUT   DD SYSOUT=*
       57 //CEEDUMP  DD SYSOUT=*
       58 //STEP040  EXEC PGM=FATRELAT
       59 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       60 //APROVIN  DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=SHR
       61 //MCCTAB   DD DSN=&SYSUID..FATURA.MCC.TABELA,DISP=SHR
       62 //RELATOUT DD DSN=&SYSUID..FATURA.RELAT(+1),
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,2),RLSE),
          //            RECFM=FBA,LRECL=133,BLKSIZE=0
       63 //SYSOUT   DD SYSOUT=*
       64 //CEEDUMP  DD SYSOUT=*
