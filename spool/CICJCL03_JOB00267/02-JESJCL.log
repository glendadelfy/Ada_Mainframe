        1 //CICJCL03 JOB ,'CICLO DO CARTAO',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*--------------------------------------------------------------------
          //* AULA 3 - COMPENSACAO (CICCLEAR) E LIQUIDACAO (CICLIQUI)
          //*   STEP005  APAGA AS SAIDAS ANTERIORES
          //*   STEP010  ORDENA O LOG DE AUTORIZACOES POR CARTAO E CODIGO
          //*   STEP020  JUNTA E ORDENA OS ARQUIVOS DE CLEARING DAS BANDEIRAS
          //*            (HEADERS PRIMEIRO, DEPOIS OS DETALHES, TRAILERS NO FIM)
          //*   STEP030  CASAMENTO E LANCAMENTOS (CICCLEAR)
          //*   STEP040  ORDENA OS LANCAMENTOS POR BANDEIRA E IRD
          //*   STEP050  LIQUIDACAO POR BANDEIRA (CICLIQUI) - DESAFIO DA AULA 3
          //* PRE-REQUISITO: O CICJCL02 JA RODOU (CICLO.AUTH.LOG EXISTE).
          //*--------------------------------------------------------------------
        2 //STEP005  EXEC PGM=IEFBR14
        3 //LOGORD   DD DSN=&SYSUID..CICLO.AUTH.LOG.ORDEN,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
        4 //CLRORD   DD DSN=&SYSUID..CICLO.CLEAR.ORDEN,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        5 //LANCANT  DD DSN=&SYSUID..CICLO.LANCAM,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
        6 //FATANT   DD DSN=&SYSUID..CICLO.FATTRANS,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        7 //EXCANT   DD DSN=&SYSUID..CICLO.EXCECAO,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
        8 //LANORD   DD DSN=&SYSUID..CICLO.LANCAM.BANDEIRA,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
        9 //LIQANT   DD DSN=&SYSUID..CICLO.LIQUIDA,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FBA,LRECL=133
          //*
       10 //STEP010  EXEC PGM=SORT
       11 //SYSOUT   DD SYSOUT=*
       12 //SORTIN   DD DSN=&SYSUID..CICLO.AUTH.LOG,DISP=SHR
       13 //SORTOUT  DD DSN=&SYSUID..CICLO.AUTH.LOG.ORDEN,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
       14 //SYSIN    DD *
          /*
          //*
       15 //STEP020  EXEC PGM=SORT
       16 //SYSOUT   DD SYSOUT=*
       17 //SORTIN   DD DSN=&SYSUID..CICLO.CLEAR.ALFA,DISP=SHR
       18 //         DD DSN=&SYSUID..CICLO.CLEAR.BETA,DISP=SHR
       19 //SORTOUT  DD DSN=&SYSUID..CICLO.CLEAR.ORDEN,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       20 //SYSIN    DD *
          /*
          //*
       21 // IF (STEP010.RC = 0 AND STEP020.RC = 0) THEN
       22 //STEP030  EXEC PGM=CICCLEAR
       23 //STEPLIB  DD DSN=&SYSUID..CICLO.LOAD,DISP=SHR
       24 //AUTLOGIN DD DSN=&SYSUID..CICLO.AUTH.LOG.ORDEN,DISP=SHR
       25 //CLEARIN  DD DSN=&SYSUID..CICLO.CLEAR.ORDEN,DISP=SHR
       26 //LANCOUT  DD DSN=&SYSUID..CICLO.LANCAM,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
       27 //FATOUT   DD DSN=&SYSUID..CICLO.FATTRANS,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,1),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       28 //EXCECOUT DD DSN=&SYSUID..CICLO.EXCECAO,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(1,1),RLSE),RECFM=FB,LRECL=120,BLKSIZE=0
       29 //SYSOUT   DD SYSOUT=*
       30 //CEEDUMP  DD SYSOUT=*
       31 // ENDIF
          //*
       32 // IF (STEP030.RC <= 4) THEN
       33 // IF (STEP040.RC = 0) THEN
       34 //STEP050  EXEC PGM=CICLIQUI
       35 //STEPLIB  DD DSN=&SYSUID..CICLO.LOAD,DISP=SHR
       36 //LANCIN   DD DSN=&SYSUID..CICLO.LANCAM.BANDEIRA,DISP=SHR
       37 //IRDTAB   DD DSN=&SYSUID..CICLO.IRD.TABELA,DISP=SHR
       38 //LIQUIOUT DD DSN=&SYSUID..CICLO.LIQUIDA,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,1),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
       39 //SYSOUT   DD SYSOUT=*
       40 //CEEDUMP  DD SYSOUT=*
       41 // ENDIF
       42 //STEP050  EXEC PGM=CICLIQUI
       43 //STEPLIB  DD DSN=&SYSUID..CICLO.LOAD,DISP=SHR
       44 //LANCIN   DD DSN=&SYSUID..CICLO.LANCAM.BANDEIRA,DISP=SHR
       45 //IRDTAB   DD DSN=&SYSUID..CICLO.IRD.TABELA,DISP=SHR
       46 //LIQUIOUT DD DSN=&SYSUID..CICLO.LIQUIDA,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,1),RLSE),RECFM=FBA,LRECL=133,BLKSIZE=0
       47 //SYSOUT   DD SYSOUT=*
       48 //CEEDUMP  DD SYSOUT=*
       49 // ENDIF
