        1        IDENTIFICATION DIVISION.
        2        PROGRAM-ID.  FATRESUM.
        3 
        4        ENVIRONMENT DIVISION.
        5        INPUT-OUTPUT SECTION.
        6        FILE-CONTROL.
        7            SELECT ARQ-DIVERG ASSIGN TO FATURA
        8                   FILE STATUS IS WS-FS-DIVERG.
        9        DATA DIVISION.
       10        FILE SECTION.
       11        FD  ARQ-DIVERG
       12            RECORDING MODE IS F.
       13            COPY CPDIVER.
       14        WORKING-STORAGE SECTION.
       15        01  WS-FS-DIVERG          PIC X(02).
       16            88 WS-FS-DIV-OK       VALUE '00'.
       17            88 WS-FS-DIV-FIM      VALUE '10'.
       18        01  WS-CONTADORES.
       19            05 WS-QTD-LIDOS        PIC 9(07) VALUE ZERO.
       20            05 WS-QTD-PS           PIC 9(07) VALUE ZERO.
       21            05 WS-QTD-FS           PIC 9(07) VALUE ZERO.
       22            05 WS-QTD-PM           PIC 9(07) VALUE ZERO.
       23 
       24        01  WS-TOTAIS.
       25            05 WS-VLR-FAT-PS       PIC 9(11)V99 VALUE ZERO.
       26            05 WS-VLR-FAT-FS       PIC 9(11)V99 VALUE ZERO.
       27            05 WS-VLR-FAT-PM       PIC 9(11)V99 VALUE ZERO.
       28 
       29            05 WS-VLR-PAG-PS       PIC 9(11)V99 VALUE ZERO.
       30            05 WS-VLR-PAG-FS       PIC 9(11)V99 VALUE ZERO.
       31            05 WS-VLR-PAG-PM       PIC 9(11)V99 VALUE ZERO.
       32 
       33        01  WS-TOT-FATURA          PIC 9(13)V99 VALUE ZERO.
       34        01  WS-TOT-PAGO            PIC 9(13)V99 VALUE ZERO.
       35 
       36        
       37        PROCEDURE DIVISION.
       38        0000-PRINCIPAL.
       39            PERFORM 1000-INICIALIZAR
       40               THRU 1000-FIM-INICIALIZAR
       41 
       42            PERFORM 2000-PROCESSAR
       43               THRU 2000-FIM-PROCESSAR
       44               UNTIL WS-FS-DIV-FIM
       45 
       46            PERFORM 3000-FINALIZAR
       47               THRU 3000-FIM-FINALIZAR
       48 
       49            GOBACK.
       50        1000-INICIALIZAR.
       51 
       52            OPEN INPUT ARQ-DIVERG
       53 
       54            IF NOT WS-FS-DIV-OK
       55               DISPLAY 'FATRESUM - ERRO OPEN FATURA.DIVERG'
       56               DISPLAY 'FS: ' WS-FS-DIVERG
       57               PERFORM 9900-ENCERRAR-COM-ERRO
       58            END-IF
       59 
       60            PERFORM 8000-LER-DIVERGENCIA
       61               THRU 8000-FIM-LER-DIVERGENCIA
       62        1000-FIM-INICIALIZAR.
       63            EXIT.
       64        2000-PROCESSAR.
       65 
       66            EVALUATE TRUE
       67 
       68            WHEN DV-PAGTO-SEM-FATURA
       69             ADD 1 TO WS-QTD-PS
       70             ADD DV-VALOR-FATURA TO WS-VLR-FAT-PS
       71             ADD DV-VALOR-PAGO   TO WS-VLR-PAG-PS
       72 
       73        WHEN DV-FATURA-SEM-PAGTO
       74             ADD 1 TO WS-QTD-FS
       75             ADD DV-VALOR-FATURA TO WS-VLR-FAT-FS
       76             ADD DV-VALOR-PAGO   TO WS-VLR-PAG-FS
       77 
       78        WHEN DV-PAGTO-A-MENOR
       79             ADD 1 TO WS-QTD-PM
       80             ADD DV-VALOR-FATURA TO WS-VLR-FAT-PM
       81             ADD DV-VALOR-PAGO   TO WS-VLR-PAG-PM
       82 
       83        WHEN OTHER
       84             DISPLAY 'TIPO INVALIDO: ' DV-TIPO
       85             MOVE 16 TO RETURN-CODE
       86 
       87        END-EVALUATE
       88 
       89        PERFORM 8000-LER-DIVERGENCIA
       90            THRU 8000-FIM-LER-DIVERGENCIA
       91        .
       92 
       93        2000-FIM-PROCESSAR.
       94        EXIT.
       95 
       96        3000-FINALIZAR.
       97            CLOSE ARQ-DIVERG
       98 
       99            IF NOT WS-FS-DIV-OK
      100               DISPLAY 'FATRESUM - ERRO CLOSE FATURA.DIVERG'
      101               DISPLAY 'FS: ' WS-FS-DIVERG
      102               MOVE 16 TO RETURN-CODE
      103            END-IF
      104 
      105            COMPUTE WS-TOT-FATURA =
      106                    WS-VLR-FAT-PS
      107                  + WS-VLR-FAT-FS
      108                  + WS-VLR-FAT-PM
      109 
      110            COMPUTE WS-TOT-PAGO =
      111                    WS-VLR-PAG-PS
      112                  + WS-VLR-PAG-FS
      113                  + WS-VLR-PAG-PM
      114 
      115            DISPLAY '*** RESUMO DE DIVERGENCIAS ***'
      116 
      117            DISPLAY 'PS - PAGTO SEM FATURA'
      118            DISPLAY 'QTD       : ' WS-QTD-PS
      119            DISPLAY 'VAL FAT   : ' WS-VLR-FAT-PS
      120            DISPLAY 'VAL PAGO  : ' WS-VLR-PAG-PS
      121 
      122            DISPLAY 'FS - FATURA SEM PAGTO'
      123            DISPLAY 'QTD       : ' WS-QTD-FS
      124            DISPLAY 'VAL FAT   : ' WS-VLR-FAT-FS
      125            DISPLAY 'VAL PAGO  : ' WS-VLR-PAG-FS
      126 
      127            DISPLAY 'PM - PAGTO A MENOR'
      128            DISPLAY 'QTD       : ' WS-QTD-PM
      129            DISPLAY 'VAL FAT   : ' WS-VLR-FAT-PM
      130            DISPLAY 'VAL PAGO  : ' WS-VLR-PAG-PM
      131 
      132            DISPLAY 'TOTAL LIDOS : ' WS-QTD-LIDOS
      133            DISPLAY 'TOTAL FATURA: ' WS-TOT-FATURA
      134            DISPLAY 'TOTAL PAGO  : ' WS-TOT-PAGO
      135 
      136            IF WS-QTD-LIDOS NOT =
      137               WS-QTD-PS +
      138               WS-QTD-FS +
      139               WS-QTD-PM
      140 
      141               DISPLAY 'FATRESUM - ERRO DE FECHAMENTO'
      142               MOVE 16 TO RETURN-CODE
      143            END-IF
      144            .
      145 
      146        3000-FIM-FINALIZAR.
      147            EXIT.
      148        8000-LER-DIVERGENCIA.
      149 
      150            READ ARQ-DIVERG
      151               AT END
      152                  CONTINUE
      153            END-READ
      154 
      155            IF NOT WS-FS-DIV-OK
      156               AND NOT WS-FS-DIV-FIM
      157 
      158               DISPLAY 'FATRESUM - ERRO READ FATURA.DIVERG'
      159               DISPLAY 'FS: ' WS-FS-DIVERG
      160 
      161               PERFORM 9900-ENCERRAR-COM-ERRO
      162            END-IF
      163 
      164            IF WS-FS-DIV-OK
      165               ADD 1 TO WS-QTD-LIDOS
      166            END-IF
      167            .
      168 
      169        8000-FIM-LER-DIVERGENCIA.
      170            EXIT.
      171        9900-ENCERRAR-COM-ERRO.
      172 
      173            MOVE 16 TO RETURN-CODE
      174            STOP RUN
      175            .
