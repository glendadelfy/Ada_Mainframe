        1 //FATJCL04 JOB ,'FATURA NOTURNA',NOTIFY=&SYSUID,
          //             CLASS=A,MSGCLASS=X
          //*--------------------------------------------------------------------
          //* AULA 4 - CHECKPOINT 2: JOB SO DE UTILITARIOS
          //*   STEP005 APAGA O BACKUP DO DIA ANTERIOR (SE EXISTIR)
          //*   STEP010 COPIA AS TRANSACOES PARA BACKUP (IEBGENER)
          //*   STEP020 ORDENA POR CARTAO, DATA E HORA E GRAVA NOVA GERACAO
          //*           DO GDG. SO RODA SE O BACKUP TERMINOU COM RC 0.
          //*--------------------------------------------------------------------
        2 //STEP005  EXEC PGM=IEFBR14
        3 //BKPANT   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        4 //APRVANT  DD DSN=&SYSUID..FATURA.TRANS.APROV,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80
        5 //REJEIANT DD DSN=&SYSUID..FATURA.TRANS.REJEI,DISP=(MOD,DELETE),
          //            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=120
        6 //
        7 //STEP010  EXEC PGM=IEBGENER
        8 //SYSPRINT DD SYSOUT=*
        9 //SYSIN    DD DUMMY
       10 //SYSUT1   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
       11 //SYSUT2   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       12 //
       13 //IFSTEP   IF (STEP010.RC = 0) THEN
       14 //
       15 //STEP020  EXEC PGM=SORT
       16 //SYSOUT   DD SYSOUT=*
       17 //SORTIN   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
       18 //SORTOUT  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80,BLKSIZE=0
       19 //SYSIN    DD  SORT FIELDS=(1,16,CH,A,17,8,CH,A,25,6,CH,A)
       20 //
       21 //STEP030  EXEC PGM=FATFILTR
       22 //STEPLIB  DD DSN=&SYSUID..FATURA.LOAD,DISP=SHR
       23 //TRANSIN  DD DSN=&SYSUID..FATURA.TRANS.ORDEN(+1),DISP=SHR
       24 //APROVOUT DD DSN=&SYSUID..FATURA.TRANS.APROV,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(2,2),RLSE),
          //            RECFM=FB,LRECL=80,BLKSIZE=0
       25 //REJEIOUT DD DSN=&SYSUID..FATURA.TRANS.REJEI,
          //            DISP=(NEW,CATLG,DELETE),
          //            SPACE=(TRK,(1,1),RLSE),
          //            RECFM=FB,LRECL=120,BLKSIZE=0
       26 //SYSOUT   DD SYSOUT=*
       27 //CEEDUMP  DD SYSOUT=*
       28 //
       29 //ENDIF
