        6 //
        7 //STEP010  EXEC PGM=IEBGENER
        8 //SYSPRINT DD SYSOUT=*
        9 //SYSIN    DD DUMMY
       10 //SYSUT1   DD DSN=&SYSUID..FATURA.TRANS.DIA,DISP=SHR
       11 //SYSUT2   DD DSN=&SYSUID..FATURA.TRANS.BKP,DISP=(NEW,CATLG,DELETE),
