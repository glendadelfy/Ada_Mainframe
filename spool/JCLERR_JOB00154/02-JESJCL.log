        1        IDENTIFICATION DIVISION.
        2        PROGRAM-ID.  FATRESUM.
        3 
        4        ENVIRONMENT DIVISION.
        5        INPUT-OUTPUT SECTION.
        6        FILE-CONTROL.
        7            SELECT ARQ-DIVERG ASSIGN TO FATURA
        8                   FILE STATUS IS WS-FS-DIVERG.
        9        DATA DIVISION.
       10        FILE SECTION.
       11        FD  ARQ-DIVERG
       12            RECORDING MODE IS F.
       13            COPY CPDIVER.
       14        WORKING-STORAGE SECTION.
       15        01  WS-FS-DIVERG          PIC X(02).
       16            88 WS-FS-DIV-OK       VALUE '00'.
       17            88 WS-FS-DIV-FIM      VALUE '10'.
       18        01  WS-CONTADORES.
       19            05 WS-QTD-LIDOS        PIC 9(07) VALUE ZERO.
       20            05 WS-QTD-PS           PIC 9(07) VALUE ZERO.
       21            05 WS-QTD-FS           PIC 9(07) VALUE ZERO.
       22            05 WS-QTD-PM           PIC 9(07) VALUE ZERO.
       23 
       24        01  WS-TOTAIS.
       25            05 WS-VLR-FAT-PS       PIC 9(11)V99 VALUE ZERO.
       26            05 WS-VLR-FAT-FS       PIC 9(11)V99 VALUE ZERO.
       27            05 WS-VLR-FAT-PM       PIC 9(11)V99 VALUE ZERO.
       28 
       29            05 WS-VLR-PAG-PS       PIC 9(11)V99 VALUE ZERO.
       30            05 WS-VLR-PAG-FS       PIC 9(11)V99 VALUE ZERO.
       31            05 WS-VLR-PAG-PM       PIC 9(11)V99 VALUE ZERO.
       32 
       33        01  WS-TOT-FATURA          PIC 9(13)V99 VALUE ZERO.
       34        01  WS-TOT-PAGO            PIC 9(13)V99 VALUE ZERO.
       35 
       36        
       37        PROCEDURE DIVISION.
       38        0000-PRINCIPAL.
       39            PERFORM 1000-INICIALIZAR
       40               THRU 1000-FIM-INICIALIZAR
       41 
       42            PERFORM 2000-PROCESSAR
       43               THRU 2000-FIM-PROCESSAR
       44               UNTIL WS-FS-DIV-FIM
       45 
       46            PERFORM 3000-FINALIZAR
       47               THRU 3000-FIM-FINALIZAR
       48 
       49            GOBACK.
       50        1000-INICIALIZAR.
       51 
       52            OPEN INPUT ARQ-DIVERG
       53 
       54            IF NOT WS-FS-DIV-OK
       55               DISPLAY 'FATRESUM - ERRO OPEN FATURA.DIVERG'
       56               DISPLAY 'FS: ' WS-FS-DIVERG
       57               PERFORM 9900-ENCERRAR-COM-ERRO
       58            END-IF
       59 
       60            PERFORM 8000-LER-DIVERGENCIA
       61               THRU 8000-FIM-LER-DIVERGENCIA
       62        1000-FIM-INICIALIZAR.
       63            EXIT.
       64        2000-FIM-PROCESSAR.
       65            EXIT.
       66               3000-FINALIZAR.
       67 
       68            CLOSE ARQ-DIVERG
       69 
       70            IF NOT WS-FS-DIV-OK
       71               DISPLAY 'FATRESUM - ERRO CLOSE FATURA.DIVERG'
       72               DISPLAY 'FS: ' WS-FS-DIVERG
       73               MOVE 16 TO RETURN-CODE
       74            END-IF
       75 
       76            COMPUTE WS-TOT-FATURA =
       77                    WS-VLR-FAT-PS
       78                  + WS-VLR-FAT-FS
       79                  + WS-VLR-FAT-PM
       80 
       81            COMPUTE WS-TOT-PAGO =
       82                    WS-VLR-PAG-PS
       83                  + WS-VLR-PAG-FS
       84                  + WS-VLR-PAG-PM
       85 
       86            DISPLAY '*** RESUMO DE DIVERGENCIAS ***'
       87 
       88            DISPLAY 'PS - PAGTO SEM FATURA'
       89            DISPLAY 'QTD       : ' WS-QTD-PS
       90            DISPLAY 'VAL FAT   : ' WS-VLR-FAT-PS
       91            DISPLAY 'VAL PAGO  : ' WS-VLR-PAG-PS
       92 
       93            DISPLAY 'FS - FATURA SEM PAGTO'
       94            DISPLAY 'QTD       : ' WS-QTD-FS
       95            DISPLAY 'VAL FAT   : ' WS-VLR-FAT-FS
       96            DISPLAY 'VAL PAGO  : ' WS-VLR-PAG-FS
       97 
       98            DISPLAY 'PM - PAGTO A MENOR'
       99            DISPLAY 'QTD       : ' WS-QTD-PM
      100            DISPLAY 'VAL FAT   : ' WS-VLR-FAT-PM
      101            DISPLAY 'VAL PAGO  : ' WS-VLR-PAG-PM
      102 
      103            DISPLAY 'TOTAL LIDOS : ' WS-QTD-LIDOS
      104            DISPLAY 'TOTAL FATURA: ' WS-TOT-FATURA
      105            DISPLAY 'TOTAL PAGO  : ' WS-TOT-PAGO
      106 
      107            IF WS-QTD-LIDOS NOT =
      108               WS-QTD-PS +
      109               WS-QTD-FS +
      110               WS-QTD-PM
      111 
      112               DISPLAY 'FATRESUM - ERRO DE FECHAMENTO'
      113               MOVE 16 TO RETURN-CODE
      114            END-IF
      115            .
      116 
      117        3000-FIM-FINALIZAR.
      118            EXIT.
      119        8000-LER-DIVERGENCIA.
      120 
      121            READ ARQ-DIVERG
      122               AT END
      123                  CONTINUE
      124            END-READ
      125 
      126            IF NOT WS-FS-DIV-OK
      127               AND NOT WS-FS-DIV-FIM
      128 
      129               DISPLAY 'FATRESUM - ERRO READ FATURA.DIVERG'
      130               DISPLAY 'FS: ' WS-FS-DIVERG
      131 
      132               PERFORM 9900-ENCERRAR-COM-ERRO
      133            END-IF
      134 
      135            IF WS-FS-DIV-OK
      136               ADD 1 TO WS-QTD-LIDOS
      137            END-IF
      138            .
      139 
      140        8000-FIM-LER-DIVERGENCIA.
      141            EXIT.
      142        2000-PROCESSAR.
      143 
      144            EVALUATE TRUE
      145 
      146            WHEN DV-PAGTO-SEM-FATURA
      147             ADD 1 TO WS-QTD-PS
      148             ADD DV-VALOR-FATURA TO WS-VLR-FAT-PS
      149             ADD DV-VALOR-PAGO   TO WS-VLR-PAG-PS
      150 
      151        WHEN DV-FATURA-SEM-PAGTO
      152             ADD 1 TO WS-QTD-FS
      153             ADD DV-VALOR-FATURA TO WS-VLR-FAT-FS
      154             ADD DV-VALOR-PAGO   TO WS-VLR-PAG-FS
      155 
      156        WHEN DV-PAGTO-A-MENOR
      157             ADD 1 TO WS-QTD-PM
      158             ADD DV-VALOR-FATURA TO WS-VLR-FAT-PM
      159             ADD DV-VALOR-PAGO   TO WS-VLR-PAG-PM
      160 
      161        WHEN OTHER
      162             DISPLAY 'TIPO INVALIDO: ' DV-TIPO
      163             MOVE 16 TO RETURN-CODE
      164 
      165        END-EVALUATE
      166 
      167        PERFORM 8000-LER-DIVERGENCIA
      168            THRU 8000-FIM-LER-DIVERGENCIA
      169        .
      170 
      171        2000-FIM-PROCESSAR.
      172        EXIT.
