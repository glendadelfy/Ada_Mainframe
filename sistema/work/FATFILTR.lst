000001C       *================================================================*
000002C       * CPTRANI  - TRANSACAO INTERNA (APOS VALIDACAO)                  *
000003C       * LRECL 80, RECFM FB. VALOR EM COMP-3 (PACKED DECIMAL).          *
000004C       * ESTE ARQUIVO E BINARIO: NAO TRANSFERIR COMO TEXTO.             *
000005C       *================================================================*
000006C        01  REG-TRANS-INTERNA.
000007C            05  TI-NUM-CARTAO          PIC X(16).
000008C            05  TI-DATA-TRANSACAO      PIC 9(08).
000009C            05  TI-HORA-TRANSACAO      PIC 9(06).
000010C            05  TI-VALOR               PIC S9(09)V99 COMP-3.
000011C            05  TI-MCC                 PIC 9(04).
000012C            05  TI-PAIS                PIC X(03).
000013C            05  TI-COD-AUTORIZACAO     PIC X(06).
000014C            05  TI-CLASSIFICACAO       PIC X(01).
000015C                88  TI-NORMAL                    VALUE 'N'.
000016C                88  TI-SUSPEITA                  VALUE 'S'.
000017C            05  TI-ESTABELECIMENTO     PIC X(20).
000018C            05  FILLER                 PIC X(10).
000040         FD  TRANS-REJEITADA
000041             RECORDING MODE IS F.
000042             COPY CPREJEI.
000001C       *================================================================*
000002C       * CPREJEI  - TRANSACAO REJEITADA NA VALIDACAO                    *
000003C       * LRECL 120, RECFM FB.                                           *
000004C       *================================================================*
000005C        01  REG-REJEITADA.
000006C            05  RJ-REGISTRO-ORIGINAL   PIC X(80).
000007C            05  RJ-COD-MOTIVO          PIC X(02).
000008C                88  RJ-CARTAO-INVALIDO           VALUE '01'.
000009C                88  RJ-VALOR-INVALIDO            VALUE '02'.
000010C                88  RJ-DATA-INVALIDA             VALUE '03'.
000011C                88  RJ-TRANSACAO-NEGADA          VALUE '04'.
000012C            05  RJ-DESC-MOTIVO         PIC X(30).
000013C            05  FILLER                 PIC X(08).
000043
000044         WORKING-STORAGE SECTION.
000045         01  WS-FS-ENTRADA              PIC X(02).
000046             88  WS-FS-ENT-OK                     VALUE '00'.
000047             88  WS-FS-ENT-FIM                    VALUE '10'.
000048         01  WS-FS-APROVADA             PIC X(02).
000049             88  WS-FS-APR-OK                     VALUE '00'.
000050         01  WS-FS-REJEITADA            PIC X(02).
000051             88  WS-FS-REJ-OK                     VALUE '00'.
